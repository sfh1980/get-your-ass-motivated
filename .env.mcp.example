# GYAM MCP environment variables
# Copy to .env.mcp (gitignored) and fill in values, OR set these in your user/system environment.
# Cursor resolves ${env:VAR} from the process environment when loading .cursor/mcp.json.

# Optional but recommended for higher Context7 rate limits: https://context7.com
CONTEXT7_API_KEY=

# Required for GitHub MCP (remote). Create a classic or fine-grained PAT:
# https://github.com/settings/tokens
# Suggested scopes: repo, read:org, workflow (as needed)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Required for Postgres MCP once the GYAM database is running.
# Use a least-privilege / read-mostly role. Example for local Docker Postgres:
# GYAM_DATABASE_URI=postgresql://gyam_readonly:CHANGE_ME@host.docker.internal:5432/gyam
GYAM_DATABASE_URI=postgresql://gyam:gyam@host.docker.internal:5432/gyam
