# Local development environment (gitignored copy: .env)
# Postgres is mapped to host port 5434 to avoid clashing with other local DBs.

DATABASE_URL=postgresql://gyam:gyam@localhost:5434/gyam
GYAM_DATABASE_URI=postgresql://gyam:gyam@host.docker.internal:5434/gyam
API_PORT=4070
WEB_ORIGIN=http://localhost:5173
SESSION_DAYS=30
# COOKIE_SECURE=true   # set when serving over HTTPS (Cloudflare/nginx)

# Optional SMTP (Yahoo: smtp.mail.yahoo.com, port 465 or 587, app password)
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@yahoo.com
# SMTP_PASS=your-app-password
# SMTP_FROM=you@yahoo.com
# SMTP_TO=you@yahoo.com
