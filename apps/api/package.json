{
  "name": "@gyam/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:push": "prisma db push && prisma generate",
    "db:seed-check": "tsx src/scripts/seed-check.ts",
    "db:remap-sample": "tsx src/scripts/remap-roadmap-sample-project.ts",
    "db:remap-python-cs": "tsx src/scripts/remap-python-cs-titles.ts"
  },
  "dependencies": {
    "@gyam/shared": "*",
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "prisma": "^6.11.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
